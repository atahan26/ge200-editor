# Copy to .env (git-ignored) and fill in only what you use. Values already set in the real environment win.
# The tone generator works with any ONE of these providers (see ge200/llm.py).

# Claude (needs: pip install anthropic)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter (many vendors behind one key)
OPENROUTER_API_KEY=

# A model you run yourself (Ollama, LM Studio, vLLM, llama.cpp server ...): your presets never leave the machine
# GE200_LLM_BASE_URL=http://localhost:11434/v1
# GE200_LLM_API_KEY=

# Which provider the editor selects first, and the default model name for the non-Claude providers
# (model names are not guessed: name one here or type it in the editor)
# GE200_LLM_PROVIDER=openai
# GE200_LLM_MODEL=
# GE200_LLM_MAX_TOKENS=8000
